# Local Postgres:
# DATABASE_URL="postgresql://user:password@localhost:5432/pickmetalk"
# Supabase (Project Settings → Database → Connection string, Session pooler):
DATABASE_URL="postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"
REDIS_URL="redis://localhost:6379"
PORT=3000
PUBLIC_BASE_URL="http://localhost:3000"

# Web Push (VAPID) — npm run vapid:generate 로 생성
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@pickmetalk.com"

# Firebase Cloud Messaging (iOS/Android)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

NODE_ENV=development

# Photo Universe — external USB library (images NOT in repo)
PHOTO_LIBRARY_ROOT="D:/PickMeTalk_PhotoLibrary"
PHOTO_UNIVERSE_ENABLED=true
PHOTO_UNIVERSE_DATA_ROOT="./data/photo-universe"
# UNIVERSE_MIN_SHORT_EDGE=720
# UNIVERSE_MIN_QUALITY=55
# UNIVERSE_WATCH_DEBOUNCE_MS=1500

# Midjourney Production Pipeline
MJ_PHOTOS_PER_CHARACTER=20
MJ_IMPORT_WATCH_FOLDER=C:/Users/user/Downloads/PickMeTalk_MJ
# FACE_AUTO_APPROVE=0.95
# FACE_REVIEW_MIN=0.80

# Publish ready photos into product catalog (app_girl-friend Supabase)
# PRODUCT_SUPABASE_URL=https://xxxx.supabase.co
# PRODUCT_SUPABASE_SERVICE_ROLE_KEY=
# PHOTO_STORAGE_BUCKET=character-photos
# PHOTO_CDN_BASE_URL=
