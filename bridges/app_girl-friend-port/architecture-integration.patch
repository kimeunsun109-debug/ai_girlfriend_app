+  food: ["치킨", "먹", "배고", "라면", "피자", "시켰", "맛집", "밥", "야식", "떡볶이"],
+  commute_done: ["퇴근", "왔어", "도착", "집에 왔", "들어왔", "끝났"],
+  happy: ["좋아", "기뻐", "최고", "행복", "신나", "대박", "좋았"],
+  sad: ["슬퍼", "우울", "속상", "눈물", "울었", "힘들어"],
+  bored: ["심심", "할 게 없", "뭐하지", "지루"],
