+
+/** Product character ids (yoonseo, not yunseo). */
+export const CHARACTER_SPEECH_HINTS: Record<
+  string,
+  { prefix?: string[]; suffix?: string[] }
+> = {
+  yuna: { suffix: ["ㅎㅎ", "~"] },
+  narin: { prefix: ["흥, ", "..."] },
+  yoonseo: { suffix: ["."] },
